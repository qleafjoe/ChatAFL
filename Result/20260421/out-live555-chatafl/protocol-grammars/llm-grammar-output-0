    "OPTIONS <<URI>> RTSP/1.0\r\n",
    "CSeq: <<CSeq>>\r\n",
    "User-Agent: <<User-Agent>>\r\n",
    "Accept: <<Accept>>\r\n",
    "\r\n"
  ],

  "DESCRIBE": [
    "DESCRIBE <<URI>> RTSP/1.0\r\n",
    "CSeq: <<CSeq>>\r\n",
    "User-Agent: <<User-Agent>>\r\n",
    "Accept: <<Accept>>\r\n",
    "\r\n"
  ],

  "SETUP": [
    "SETUP <<URI>> RTSP/1.0\r\n",
    "CSeq: <<CSeq>>\r\n",
    "User-Agent: <<User-Agent>>\r\n",
    "Transport: <<Transport>>\r\n",
    "\r\n"
  ],

  "PLAY": [
    "PLAY <<URI>> RTSP/1.0\r\n",
    "CSeq: <<CSeq>>\r\n",
    "User-Agent: <<User-Agent>>\r\n",
    "Session: <<Session>>\r\n",
    "Range: <<Range>>\r\n",
    "\r\n"
  ],

  "PAUSE": [
